tempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}], "id": 11, "stimuli_ids": []}], "type": "scholar", "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "audio", "id": 1, "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn10le05ob02re2aud01", "coverimg": "engenn10le05ob02re2img01.jpg", "images": [{"image": "engenn10le05ob02re2img01.jpg", "text": "", "id": 0, "time": "0"}, {"image": "engenn10le05ob02re2img01.jpg", "text": "The earliest definite human remains to be found by archaeologists in Australia are those of Mungo Man, dated at 40,000 years old. Trying to tie the DNA of this group of people to the Aboriginal people in Australia has been unsuccessful. However, findings show that it's possible to relate the Aborigines to another group of people arriving in Australia from Africa 50,000 years ago.", "id": 1, "time": "100"}, {"image": "engenn10le05ob02re2img02.jpg", "text": "About 500 Aboriginal tribal groups are to be identified in different regions of the Australian continent. These tribes are noted as speaking different languages and following different lifestyles. However, it is to be emphasized that all share a belief in the importance of land and family.<br/>The Aborigines have been able to live in harmony without leaders or heroes. Harmony instead, is to be brought about by staying in tune with nature. One way of keeping this connection to nature and spiritual forces is through storytelling.", "id": 2, "time": "28000"}, {"image": "engenn10le05ob02re2img03.jpg", "text": "Their songs and stories are sung and told to celebrate Dreamtime, the mythical time when the world was created. Some stories seem to be focused on animals. Others talk about the three spirits: the Yowee, exemplifying the soul, the Doowee, representing the dreams, and the Mulloowil embodying the shadow spirit, all of which are  to be found in everyone. <br/>Today, through Dreamtime storytelling, art, and language, Australia's Aborigines still maintain a connection to their ancient culture and traditions, and keep them by passing them to the next generation.", "id": 3, "time": "64000"}]}}], "_data": []}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "Traveling Without Moving", "type": "lesson_name"}, {"content": "Australian Aborigines", "type": "unit_name"}, {"content": 2, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 5, "type": "lesson"}, {"content": "B2.2", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe detailed facts about events or actions in work and social contexts, in written or spoken situations.", "type": "primary"}, {"content": "Understands general and detailed information, including specialized articles of the professional or academic life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_1"}, {"content": "Understands general and detailed information, including specialized articles of the professional or academic life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_2"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_3"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_4"}, {"content": "Understands general and detailed information, including specialized articles of the professional or academic life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_5"}, {"content": "Understands general and detailed information, including specialized articles of the professional or academic life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_6"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_7"}, {"content": "Understands the main ideas and specific information of complex text on both concrete and abstract topics in written texts in social and work contexts.", "type": "secondary_8"}]}, {"type": "target_word", "contents": [{"content": "archaeologist", "type": "name"}, {"content": "a person who studies past civilizations", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Archaeologists in Australia found the earliest definite human remains.", "type": "example"}, {"content": "engenn10le05ob02aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about Australia's Aborigines.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "human remains", "type": "name"}, {"content": "bones or tissue of the dead", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The earliest definite human remains  found by archaeologists in Australia are dated at 40,000 years old. ", "type": "example"}, {"content": "engenn10le05ob02aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "Aboriginal people", "type": "name"}, {"content": "one way of naming Australia's indigenous people ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The majority of Aboriginal people in Australia live in the eastern states.", "type": "example"}, {"content": "engenn10le05ob02aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "unsuccessful", "type": "name"}, {"content": "not achieving a result", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Trying to tie them to the Mungo people has been unsuccessful.", "type": "example"}, {"content": "engenn10le05ob02aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "Aborigines", "type": "name"}, {"content": "a second way of naming Australia's indigenous people ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The Aborigines lived in Australia.", "type": "example"}, {"content": "engenn10le05ob02aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "harmony", "type": "name"}, {"content": "living in peace with", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The Aborigines have been able to live in harmony without leaders or heroes.", "type": "example"}, {"content": "engenn10le05ob02aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to emphasize", "type": "name"}, {"content": "to make more obvious", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: It is to be emphasized that all share a belief in the importance of land and family.", "type": "example"}, {"content": "engenn10le05ob02aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "spiritual forces", "type": "name"}, {"content": "what animates living things", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: One way of keeping this connection to nature and spiritual forces is through storytelling.", "type": "example"}, {"content": "engenn10le05ob02aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to stay in tune with ", "type": "name"}, {"content": "to keep having a good understanding of ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example:  Harmony instead, is to be brought about by staying in tune with nature. ", "type": "example"}, {"content": "engenn10le05ob02aud09", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "Dreamtime", "type": "name"}, {"content": "aboriginal mythology", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Today, through Dreamtime storytelling, art, and language, Australia's Aborigines still maintain a connection to their ancient culture and traditions.", "type": "example"}, {"content": "engenn10le05ob02aud10", "type": "audio"}]}, {"content": "engenn10le05ob02re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Passive Infinitives: Focusing on the Action", "type": "heading"}, {"content": "If the subject of the sentence is the agent (the doer), you use an active sentence with an <span class=\"strong\">active infinitive</span>.<br/>  If the subject is not the agent, we use a <span class=\"strong\">passive infinitive</span>.", "type": "describer"}, {"content": "Compare these two sentences:", "type": "text"}, {"content": "<span class=\"underline\">Active</span>: <span class=\"italic\">I've got so many library books to <span class=\"strong\">return</span>.</span>", "type": "text"}, {"content": "Here the subject is I, who performs the action (return).", "type": "text"}, {"content": "<span class=\"underline\">Passive</span>: <span class=\"italic\">All library books have <span class=\"strong\">to be returned</span> on time.</span>", "type": "text"}, {"content": "Here, the subject is not identified. In this case, we use a <span class=\"underline\">passive infinitive</span>.", "type": "text"}, {"content": "Look at the chart for the structure of the <span class=\"underline\">passive infinitive</span>.", "type": "text"}, {"content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"><span class=\\\"strong\\\">Structure\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"><span class=\\\"strong\\\">Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Subject + <span class=\\\"italic\\\">to be</span> + past participle\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">The earliest remains of humans <span class=\\\"strong\\\">to be found</span> by archaeologists are those of Mungo Man in Australia.</span>\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}, {"content": "About 500 Aboriginal tribal groups are to be identified in different regions of the Australian continent.", "type": "example"}, {"content": "However, it is to be emphasized that all share a belief in the importance of land and family.", "type": "example"}, {"content": "Harmony instead, is to be brought about by staying in tune with nature.", "type": "example"}, {"content": "Some stories seem to be focused on animals.", "type": "example"}, {"content": "All of which are  to be found in everyone.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Gerunds", "type": "heading"}, {"content": "A gerund looks like a verb but acts like a noun.", "type": "describer"}, {"content": "Gerunds are like nouns, because they can act as the subject, object or subject complement in a sentence:<br/> <span class=\"italic\"><ul><li><span class=\"strong\">Shopping</span> costs a lot of money.<br/> <li>I don't like <span class=\"strong\">driving</span>.<br/> <li>My favorite hobby is <span class=\"strong\">singing</span>.<br/></li></ul></span>", "type": "text"}, {"content": "Gerunds can also have objects and be followed by modifiers.</br></br><span class=\"italic\">Drinking <span class=\"strong\">alcohol</span> can cause health problems.</span> (object)</br><span class=\"italic\">Drinking <span class=\"strong\">too much</span> alcohol can cause health problems.</span>(modifier)</br></br> Like nouns, we can use gerunds with adjectives, articles and determiners, like pronouns:", "type": "text"}, {"content": "However, findings show that it's possible to relate the Aborigines to another group of people arriving in Australia from Africa 50,000 years ago.", "type": "example"}, {"content": "Trying to tie the DNA of this group of people to the Aboriginal people in Australia has been unsuccessful. ", "type": "example"}, {"content": "Harmony instead, is to be brought about by staying in tune with nature. One way of keeping this connection to nature and spiritual forces is through storytelling.", "type": "example"}, {"content": "One way of keeping this connection to nature and spiritual forces is through storytelling.", "type": "example"}, {"content": "Others talk about the three spirits: the Yowee, exemplifying the soul, the Doowee, representing dreams, and the Mulloowil embodying the shadow spirit. ", "type": "example"}, {"content": "<span class=\"italic\"><ul><li>pointless <span class=\"strong\">questioning</span><br/> <li>the <span class=\"strong\">writing</span> of this film<br/> <li>his <span class=\"strong\">smoking</span> of cigarettes</li></ul></span>", "type": "text"}]}, {"type": "takeaway_extension", "contents": [{"content": "Find an Australian Aboriginal dreamtime story.", "type": "text"}, {"content": "Take notes on the main points.", "type": "text"}, {"content": "Put your notes on a timeline and add vocabulary to enhance the story with vocabulary for that culture.", "type": "text"}, {"content": "Practice telling the story aloud using your timeline and notes.", "type": "text"}, {"content": "Tell a partner the story.", "type": "text"}, {"content": "Discuss why you think the Aboriginal people feel this story is important.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I find and read an Australian Aboriginal dreamtime story.", "type": "text"}, {"content": "I take notes and add vocabulary words to enhance it.", "type": "text"}, {"content": "I practice recounting the story aloud.", "type": "text"}, {"content": "I tell the story to someone.", "type": "text"}, {"content": "I discuss the meaning and importance of the story.", "type": "text"}]}]}